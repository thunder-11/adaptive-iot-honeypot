# Network identity. Use 127.0.0.1 for the laptop-only test.
PI_IP=127.0.0.1
ESP32_IP=192.168.1.50

# Credentials used only by the real broker.
REAL_USER=iotuser
REAL_PASS=change-this-before-demo

# Listener ports.
PROXY_PORT=1883
REAL_PORT=1884
DECOY_PORT=1885
DASH_PORT=5000

# Optional TLS termination for the client-facing proxy. Leave both empty for plaintext.
TLS_CERT_PATH=
TLS_KEY_PATH=

# Routing thresholds.
MEDIUM=21
HIGH=41
CRITICAL=51

# Risk scoring controls.
WEIGHT_CONNECTION_RATE=15
WEIGHT_FAILED_AUTH=8
FAILED_AUTH_CAP=40
WEIGHT_WILDCARD_SUBSCRIBE=25
WEIGHT_COMMAND_PUBLISH=20
WEIGHT_BLACKLIST=30
WEIGHT_TOPIC_ENUMERATION=12
WEIGHT_PUBLISH_RATE=15
WEIGHT_MALFORMED_PACKET=12
WEIGHT_SHORT_SESSION=3
SHORT_SESSION_CAP=12
WEIGHT_COMMAND_SEQUENCE=15
WEIGHT_DECOY_ENGAGEMENT=5
CONNECTION_LIMIT=10
CONNECTION_WINDOW_SEC=10
TOPIC_ENUMERATION_LIMIT=5
PUBLISH_LIMIT=20
PUBLISH_WINDOW_SEC=10
SHORT_SESSION_SEC=2
DECAY_POINTS_PER_SEC=0.1
SCORE_CHECKPOINT_SEC=5
THROTTLE_DELAY_SEC=1.0
THROTTLE_PACKET_DELAY_SEC=0.1

# Broker hosts remain loopback for native use; Docker overrides them by environment.
REAL_HOST=127.0.0.1
DECOY_HOST=127.0.0.1
DECOY_BIND_IP=127.0.0.1

# Decoy profile: auto, smart_lock, or thermostat.
DECOY_PROFILE=auto

# High/critical alerting. Alerts always go to the local log when enabled.
ALERT_ENABLED=true
ALERT_MIN_ACTION=throttle
ALERT_WEBHOOK_URL=
ALERT_LOG_FILE=logs/alerts.log
ALERT_COOLDOWN_SEC=30

# Optional ThingSpeak cloud telemetry. Create one channel with fields:
# 1=motion, 2=locked, 3=LED on, 4=risk score, 5=action code, 6=event points.
THINGSPEAK_ENABLED=false
THINGSPEAK_WRITE_API_KEY=
THINGSPEAK_CHANNEL_ID=
THINGSPEAK_UPDATE_URL=https://api.thingspeak.com/update
THINGSPEAK_INTERVAL_SEC=15

# Comma-separated addresses. Loopback is required for local dashboard/tools.
WHITELIST_IPS=127.0.0.1,192.168.1.50
WHITELIST_MAX_ANOMALY_SCORE=40
BLACKLIST_IPS=
DECOY_FORCE_IPS=
